{
  "manifest_version": 3,
  "name": "PicSift - 商品图片提取器",
  "version": "0.0.2",
  "description": "一键提取阿里巴巴、1688、中国制造网等商品页面中的高清主图和详情图",
  "author": "Everett Labs (https://everettlabs.dev/)",
  "homepage_url": "https://everettlabs.dev/",
  "permissions": [
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.alibaba.com/*",
    "https://*.1688.com/*",
    "https://*.made-in-china.com/*",
    "https://*.amazon.com/*",
    "https://*.aliexpress.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.jd.com/*",
    "https://*.ebay.com/*",
    "https://*.shopee.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.alibaba.com/*",
        "https://*.1688.com/*",
        "https://*.made-in-china.com/*",
        "https://*.amazon.com/*",
        "https://*.aliexpress.com/*",
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.jd.com/*",
        "https://*.ebay.com/*",
        "https://*.shopee.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
